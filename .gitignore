# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies（pnpm workspace では apps/*/node_modules もできる。Issue #68 の段階 2）
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js（next build apps/frontend は apps/frontend/.next/ に出力する。Issue #68）
/apps/frontend/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example は接続情報の例（開発用の固定値だけで秘密を含まない）。コピー元としてコミットする。
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright（E2E テストの実行結果・レポート。実行のたびに生成される）
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# stryker（mutation testing の実行結果。reports/mutation/ にレポート、.stryker-tmp/ に実行中のサンドボックスが作られる）
/reports/
/.stryker-tmp/
