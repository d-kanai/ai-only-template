# prod 環境の入力の例。`cp terraform.tfvars.example terraform.tfvars` でコピーして値を書く（terraform.tfvars は .gitignore 済み。
#   コミットしない。プロジェクト ID・メールアドレスを含むため）。
# 変数の一覧と既定値は variables.tf、意味と WHY は infra/modules/app/variables.tf。書かない変数は既定値になる。

# 必須: prod の GCP プロジェクト ID（stg と prod は別のプロジェクト）。
project_id = "<prod のプロジェクト ID>"

# 推奨: リポジトリの数値の id（WIF の条件に加わる。gh api repos/<owner>/<repo> --jq .id）。
# github_repository_id = 123456789

# Cloud SQL の MCP を使う Google アカウント（infra/README.md の手順 9）。
# sql_iam_users = ["you@example.com"]

# prod の負荷が増えたとき（接続数の予算も見直す。infra/modules/app/sql.tf）。
# sql_tier = "db-g1-small"

# prod のコールドスタートを無くすとき（常時 1 インスタンス分の課金）。
# customer_min_instances = 1

# Metabase を常時使うとき（月 約 $19 増える）。
# metabase_min_instances = 1
