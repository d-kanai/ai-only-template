// apps/shared の tsconfig（Issue #90）。apps/shared 単体の型チェック（pnpm exec tsc -p apps/shared --noEmit。pnpm typecheck に含む）に使う。
// apps/shared は frontend と backend で共通の基盤（環境変数の入口 env.ts・ログの出口 logger.ts）で、サーバ側（Node.js）でだけ動く。
// WHY apps/backend/tsconfig.json と同じ方針（DOM の型なし・Next の plugin なし・jsx なし）: env.ts・logger.ts は Node の API
//   （process・node:fs・console）だけを使う pure な TypeScript にし、ブラウザや React の API を使うと型エラーになるようにする。
//   frontend から import される（instrumentation-node.ts・proxy.ts）が、Next のビルドでは apps/frontend/tsconfig.json の設定で
//   型チェックされるので、DOM の型が無いことの検査はここ（と apps/backend の tsconfig。backend も import する）で行う。
// WHY paths を持たない: apps/shared の中は同じディレクトリのファイルを相対パスで読むだけで（今はファイル同士の import も無い）、
//   ほかのパッケージ（@repo/backend・frontend の "@/"）を参照しない（.claude/rules/shared.md）。
// compilerOptions は apps/backend/tsconfig.json と同じ値にしている（そろえておくと、backend 経由で型チェックされたときと
//   ここで型チェックしたときの結果が同じになる）。
{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // types: @types/node だけを読む（@types/react など、リポジトリ直下の node_modules/@types にある他の型を入れない）。
    //   apps/shared は依存を持たないので、@types/node はリポジトリ直下の node_modules から解決される（apps/backend と同じ）。
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.mts"],
  "exclude": ["node_modules"]
}
