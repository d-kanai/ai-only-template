# アプリ・テスト・ツール（drizzle-kit / Playwright / Vitest）が読む環境変数。E2E_PORT（任意）以外はすべて必須で、コードに既定値は無い。
# 使い方: このファイルを .env にコピーする。
#   cp .env.example .env
# .env は .gitignore 済み（.env*）で、コミットされない。このファイル（.env.example）だけがコピー元としてコミットされる。
# 置き場所: リポジトリ直下に 1 つだけ（apps/frontend_customer/ や apps/backend/ には置かない。Issue #68）。
# 読み込み: apps/shared/env.ts が読み込み時に、カレントディレクトリから上に pnpm-workspace.yaml のあるディレクトリ
#   （リポジトリ直下）を探して、そこの .env を読む（Node の process.loadEnvFile）。next dev / build / start（Vitest・Playwright・
#   drizzle-kit も）はすべてこの経路で読む。Next.js 自身はプロジェクトのディレクトリ（apps/frontend_customer）の .env を探すので、
#   リポジトリ直下のこのファイルは Next.js 自身は読まない（2026-09-28 実測。.claude/rules/tooling/env.md の「環境変数」）。
#   すでに環境変数として渡した値は .env の値より優先される（例: DATABASE_URL=... pnpm db:migrate）。
# 検証: apps/shared/env.ts が読み込み時に全件を検証し、欠けている・不正な変数の名前をまとめて 1 つのエラーにして止まる。
# 下の値はすべて開発・CI・E2E 用。compose.yaml の開発用 DB に合わせた値で、秘密ではない。
# 本番用の値（接続数・タイムアウト・TLS など）は Issue #58 で決める（.claude/rules/code/backend.md の「Repository」の表の「接続とプール」）。

# DATABASE_URL: Postgres の接続先。compose.yaml の POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB（app / app / app）と
#   ports（5432）に合わせている。pnpm db:up で起動した開発用 DB を指す。
DATABASE_URL=postgresql://app:app@localhost:5432/app

# DATABASE_POOL_MAX: プール（node-postgres の Pool）の最大接続数。1 以上の整数。
#   10 は node-postgres の既定と同じ。Postgres の既定の max_connections（100）に対し、next start の 1 プロセスが使う数として十分小さい。
DATABASE_POOL_MAX=10

# DATABASE_POOL_IDLE_TIMEOUT_MS: 使われない接続を閉じるまでの時間（ミリ秒）。0 以上の整数。
#   10000 は node-postgres の既定と同じ。
DATABASE_POOL_IDLE_TIMEOUT_MS=10000

# DATABASE_CONNECTION_TIMEOUT_MS: 接続待ちの上限（ミリ秒）。0 以上の整数（0 は無制限）。
#   node-postgres の既定は 0（無制限）だが、DB が落ちている・プールが埋まっているときにリクエストが無期限に待ち、
#   画面が固まるのを避けるため、5 秒で諦めてエラー（API は 500）にする。
DATABASE_CONNECTION_TIMEOUT_MS=5000

# DB 側のタイムアウト（Issue #58）。どれも 0 以上の整数（ミリ秒）。
#   0 は Postgres に送らない（node-postgres は偽の値を接続パラメータに載せない。pg 8.23.0 の client.js）ので、DB・ロールの既定に
#   従う。今の Cloud SQL・compose の Postgres はどれも既定（0 = 上限なし）のまま（infra/modules/app/sql.tf の database_flags）。
#   node-postgres が接続を作るときに Postgres に送り、その接続のセッションの既定値になる（apps/backend/shared/drizzle/database.ts）。
#   WHY 置く: プールの接続は数本しかなく、DB 側に上限が無いと、遅い文・ロック待ち・開いたままのトランザクションが接続を握り続け、
#   残りのリクエストが接続待ち（DATABASE_CONNECTION_TIMEOUT_MS）で一斉に失敗する。打ち切られた要求は API で 500 になる。
# DATABASE_STATEMENT_TIMEOUT_MS: 1 つの文の実行時間の上限（statement_timeout）。
#   10 秒: 今の API の文はどれも 1 行か一覧の SELECT / INSERT / UPDATE で、10 秒かかるなら異常（画面も待てない）。
DATABASE_STATEMENT_TIMEOUT_MS=10000

# DATABASE_LOCK_TIMEOUT_MS: 行ロックなどを待つ上限（lock_timeout）。
#   3 秒: 同じ Todo の同時更新は findByIdForUpdate の FOR UPDATE で直列にしていて、相手のトランザクションは数往復で終わる。
#   3 秒待っても取れないのは相手が詰まっているときで、待ち続けて接続を握るより諦める（statement_timeout より短くして、ロック待ちと
#   遅い文をエラーの SQLSTATE で見分けられるようにする: 55P03 lock_not_available / 57014 query_canceled）。
DATABASE_LOCK_TIMEOUT_MS=3000

# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS: トランザクションを開いたまま何もしていない接続を切るまでの時間
#   （idle_in_transaction_session_timeout）。30 秒: command はトランザクションの中で外部を待たない（.claude/rules/code/backend.md）ので、
#   正常なら 0 に近い。COMMIT し忘れなどのバグで行ロックと接続を握り続けるのを止める保険。
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# GCP_PROJECT_ID: GCP のプロジェクト ID。リクエストログ（apps/frontend_customer/proxy.ts）の trace の値
#   projects/<GCP_PROJECT_ID>/traces/<trace-id>（Cloud Logging の特別フィールド logging.googleapis.com/trace）に入れる（Issue #209）。
#   local: 手元・CI・E2E には GCP のプロジェクトが無いので、実在しない名前にする（Cloud Logging に送られないので何にも結び付かなくてよい）。
#   traceparent ヘッダの付いたリクエストでだけ使う（手元のブラウザは付けない）。本番の値は Cloud Run の env（infra/modules/app/run.tf）が
#   Terraform の var.project_id から渡す。
GCP_PROJECT_ID=local

# E2E_PORT: E2E（pnpm test:e2e）が本番ビルド（next start）を起動するポート。1〜65535 の整数。apps/e2e/playwright.config.ts が読む。
#   任意。未設定なら 3100（env.ts の toolEnv。E2E 専用でアプリは使わないため必須にしない）。値があれば検証し、不正ならエラー。
#   3100 は pnpm dev の既定（3000）と重ねないため（開発サーバを起動したままでも E2E を実行できる）。
#   この行は worktree 用の値の導出の元なので消さない（scripts/worktree-env.sh は、この行が無いと .env を作らずに失敗する）。
#   worktree（.claude/worktrees/<名前>）では、WorktreeCreate フック（scripts/hooks/worktree-create.sh）が scripts/worktree-env.sh で
#   worktree の名前から 3101〜3900 の値を導いて書き換える。WHY worktree ごとに変える: 並列の worktree が同じポートを使うと、
#   playwright の reuseExistingServer により、別の worktree で起動したサーバ（別のコード・別の DB）を検証してしまうため
#   （.claude/rules/tooling/worktree.md）。
E2E_PORT=3100
