{
  "name": "ai-only-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "TZ=UTC pnpm --filter @repo/frontend-customer --fail-if-no-match dev",
    "build": "pnpm --filter @repo/frontend-customer --fail-if-no-match build",
    "start": "TZ=UTC pnpm --filter @repo/frontend-customer --fail-if-no-match start",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:api-journey": "vitest run apps/backend/spec/journey",
    "test:e2e": "pnpm --filter @repo/e2e --fail-if-no-match test",
    "test:mutation": "stryker run",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc -p . --noEmit && tsc -p apps/backend --noEmit && tsc -p apps/shared --noEmit",
    "format": "biome format --write .",
    "check": "biome check --write --error-on-warnings .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U app -d app",
    "db:generate": "pnpm --filter @repo/backend --fail-if-no-match db:generate",
    "db:migrate": "pnpm --filter @repo/backend --fail-if-no-match db:migrate"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@biomejs/biome": "2.5.13",
    "@repo/shared": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "30.1.1",
    "lefthook": "2.1.12",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.7.0"
}
